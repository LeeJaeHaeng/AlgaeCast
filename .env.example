# AlgaeCast-7 환경변수 예시. 복사해서 .env 로 저장하고 값을 채운다. (.env 는 절대 커밋 금지)

# data.go.kr 일반 인증키 — Decoding 키(슬래시·등호가 그대로인 형태). requests params 로 전달할 때 사용.
DATA_GO_KR_KEY=
# 같은 키의 Encoding 형태(%2F, %3D). URL 문자열에 직접 이어 붙일 때만 사용.
DATA_GO_KR_KEY_ENC=

# 승인된 data.go.kr 엔드포인트 (개발계정, 활용기간 2026-10-20 ~ 2028-10-20)
API_KMA_ASOS_HOURLY=https://apis.data.go.kr/1360000/AsosHourlyInfoService/getWthrDataList
API_KMA_ASOS_DAILY=https://apis.data.go.kr/1360000/AsosDalyInfoService/getWthrDataList
API_KWATER_DAM=https://apis.data.go.kr/B500001/dam/multipurPoseDam/multipurPoseDamlist
API_NIER_ALGAE=https://apis.data.go.kr/1480523/nieragainstalgae/algaePreMeasure

# 기상청 API허브 (apihub.kma.go.kr) — MT-04/05 과거 예보 자료용
KMA_APIHUB_KEY=

# Supabase (T6)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel ISR 재검증 (T7/T8)
REVALIDATE_SECRET=

# --- 2026-10-20 추가 승인 (개발계정) ---
# K-water 수문 운영 정보 (HY-02, #15099110): /hourlist /mntlist /delist, 각 일 10,000. 파라미터 damcode, stdt, eddt(YYYY-MM-DD), _type
API_KWATER_SLUICE=https://apis.data.go.kr/B500001/dam/sluicePresentCondition
# K-water 댐코드 조회 (HY-04, #15099105): /damCodelist, 일 100 (!) — 댐·보 코드 60개 (보 코드 포함)
API_KWATER_DAMCODE=https://apis.data.go.kr/B500001/dam/damCode/damCodelist
# 기상청 단기예보 2.0 (MT-05): /getVilageFcst /getUltraSrtFcst /getUltraSrtNcst /getFcstVersion, 일 10,000 (활용기간 2026-01-03~2028-01-03)
API_KMA_VILAGE_FCST=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
# 기상청 유역별 강수량 자료 (odcloud #15068582): 2020-08-01 단일 일자 850개 표준유역 스냅샷 — 시계열 아님
API_KMA_BASIN_RAIN_ODCLOUD=https://api.odcloud.kr/api/15068582/v1/uddi:90592c56-a366-4de8-933c-a96814b2cd0f
# WAMIS 표준수문DB 개방 API 키 (HY-06, 한강홍수통제소 wamis.go.kr). 보 수위·유량. 동일 키를 data.go.kr '표준수문DB' 에도 사용
WAMIS_KEY=
API_WAMIS_BASE=http://www.wamis.go.kr:8080/wamis/openapi

# 물모아플랫폼 (www.mulmoa.go.kr, 환경부 물환경 통합 플랫폼) API 키 — WQ-04 'AI 녹조 정밀 예측 정보' 벤치마크 수집용 (2026-10-20 발급)
# 2026-10-20 상태: resultCode 31 '사용할 수 없는 API Key' = 관리자 승인 대기. 인증은 쿼리 파라미터 apikey, 일 3,000건
API_MULMOA_BASE=https://mulmoa.go.kr/api/v1
MULMOA_API_KEY=
API_KMA_MID_FCST=https://apis.data.go.kr/1360000/MidFcstInfoService
SUPABASE_DB_PASSWORD=
# (참고) 새 형식 키: SUPABASE_PUBLISHABLE_KEY= / SUPABASE_SECRET_KEY=
SUPABASE_DB_HOST=
