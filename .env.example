# AlgaeCast-7 환경변수 예시. 복사해서 .env 로 저장하고 값을 채운다. (.env 는 절대 커밋 금지)

# data.go.kr 일반 인증키 — Decoding 키(슬래시·등호가 그대로인 형태). requests params 로 전달할 때 사용.
DATA_GO_KR_KEY=
# 같은 키의 Encoding 형태(%2F, %3D). URL 문자열에 직접 이어 붙일 때만 사용.
DATA_GO_KR_KEY_ENC=

# 승인된 data.go.kr 엔드포인트 (개발계정, 활용기간 2026-10-20 ~ 2028-10-20)
API_KMA_ASOS_HOURLY=https://apis.data.go.kr/1360000/AsosHourlyInfoService/getWthrDataList
API_KMA_ASOS_DAILY=https://apis.data.go.kr/1360000/AsosDalyInfoService/getWthrDataList
API_KWATER_DAM=https://apis.data.go.kr/B500001/dam/multipurPoseDam/multipurPoseDamlist
API_NIER_ALGAE=https://apis.data.go.kr/1480523/nieragainstalgae/algaePreMeasure

# 기상청 API허브 (apihub.kma.go.kr) — MT-04/05 과거 예보 자료용
KMA_APIHUB_KEY=

# Supabase (T6)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel ISR 재검증 (T7/T8)
REVALIDATE_SECRET=
