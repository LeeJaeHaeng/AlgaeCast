# ---- 비밀값 ----
.env
.env.*
!.env.example

# ---- Python ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.mypy_cache/

# ---- 데이터 (대회 제공 데이터·원본은 커밋 금지, MANIFEST.md 만 커밋) ----
data/raw/*
!data/raw/.gitkeep
!data/raw/MANIFEST.md
!data/raw/cache/
data/raw/cache/*
!data/raw/cache/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/predictions/*
!data/predictions/.gitkeep
data/.manifest.json

# ---- 실험·로그 ----
optuna.db
logs/*
!logs/.gitkeep

# ---- 웹 ----
web/node_modules/
web/.next/
web/.vercel/
web/.env*.local

# ---- OS / IDE ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
