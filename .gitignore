# ---- 비밀값 ----
.env
.env.*
!.env.example

# ---- Python ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.mypy_cache/

# ---- 데이터 (대회 제공 데이터·원본은 커밋 금지, MANIFEST.md 만 커밋) ----
data/raw/*
!data/raw/.gitkeep
!data/raw/MANIFEST.md
!data/raw/cache/
data/raw/cache/*
!data/raw/cache/.gitkeep
# 물모아 예측 스냅샷 CSV 는 공개 벤치마크 원자료(소량) → 커밋 허용, 원문 JSON(raw/)은 제외
!data/raw/mulmoa/
data/raw/mulmoa/raw/
# 기상 예보 발표분 CSV(T1-e, 일 1회 소량, 공공데이터) → 커밋 허용
!data/raw/kma_forecast/
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/predictions/*
!data/predictions/.gitkeep
data/.manifest.json

# ---- 실험·로그 ----
optuna.db
logs/*
!logs/.gitkeep

# ---- 웹 ----
web/node_modules/
web/.next/
web/.vercel/
web/.env*.local

# ---- OS / IDE ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
